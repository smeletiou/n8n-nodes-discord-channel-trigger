; n8n-workflow (a peerDependency, needed only for TypeScript types like
; ITriggerFunctions) transitively depends on isolated-vm, a native addon
; that requires a C++ build toolchain to compile.
;
; We never execute anything from n8n-workflow locally -- the real n8n
; Docker container has its own precompiled isolated-vm at runtime. So we
; skip install/postinstall scripts for everything, which avoids the
; native compile step entirely.
ignore-scripts=true
