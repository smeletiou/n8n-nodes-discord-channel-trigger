{
	"name": "n8n-nodes-discord-channel-trigger",
	"version": "0.1.0",
	"description": "n8n trigger node that fires when your Discord bot sees a new message in specific channels",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Your Name",
		"email": "you@example.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/your-username/n8n-nodes-discord-channel-trigger.git"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
		"build:watch": "tsc --watch"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/DiscordBotApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DiscordChannelTrigger/DiscordChannelTrigger.node.js"
		]
	},
	"dependencies": {
		"discord.js": "^14.16.3"
	},
	"devDependencies": {
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
