{
	"name": "n8n-nodes-discord-channel-trigger",
	"version": "0.1.0",
	"description": "n8n trigger node that fires when your Discord bot sees a new message in specific channels",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Your Name",
		"email": "you@example.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/your-username/n8n-nodes-discord-channel-trigger.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/DiscordBotApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DiscordChannelTrigger/DiscordChannelTrigger.node.js"
		]
	},
	"dependencies": {
		"discord.js": "^14.16.3"
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
